{
  "name": "personal-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply personal-site-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply personal-site-db --remote",
    "posts:import:local": "mkdir -p .wrangler && node scripts/import-mdx-posts.mjs > .wrangler/import-posts.sql && wrangler d1 execute personal-site-db --local --file .wrangler/import-posts.sql"
  },
  "dependencies": {
    "@elevenlabs/react": "^0.13.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@react-email/components": "^0.5.6",
    "@react-email/render": "^1.3.2",
    "marked": "^18.1.1",
    "next": "^15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.5",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  }
}
